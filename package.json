        "default": "./dist/widgets/CloudflareWorldMap/Component.client.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "dependencies": {
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1"
  }
}
