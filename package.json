{
  "name": "@main12/payload-cloudflare-widgets",
  "version": "0.1.0",
  "description": "Payload CMS plugin providing Cloudflare analytics dashboard widgets",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./rsc": {
      "import": "./src/exports/rsc.ts",
      "types": "./src/exports/rsc.ts",
      "default": "./src/exports/rsc.ts"
    },
    "./widgets/cloudflare-traffic": {
      "import": "./src/widgets/CloudflareTraffic/Component.client.tsx",
      "types": "./src/widgets/CloudflareTraffic/Component.client.tsx",
      "default": "./src/widgets/CloudflareTraffic/Component.client.tsx"
    },
    "./widgets/cloudflare-bandwidth": {
      "import": "./src/widgets/CloudflareBandwidth/Component.client.tsx",
      "types": "./src/widgets/CloudflareBandwidth/Component.client.tsx",
      "default": "./src/widgets/CloudflareBandwidth/Component.client.tsx"
    },
    "./widgets/cloudflare-cache-rate": {
      "import": "./src/widgets/CloudflareCacheRate/Component.client.tsx",
      "types": "./src/widgets/CloudflareCacheRate/Component.client.tsx",
      "default": "./src/widgets/CloudflareCacheRate/Component.client.tsx"
    },
    "./widgets/cloudflare-devices": {
      "import": "./src/widgets/CloudflareDevices/Component.client.tsx",
      "types": "./src/widgets/CloudflareDevices/Component.client.tsx",
      "default": "./src/widgets/CloudflareDevices/Component.client.tsx"
    },
    "./widgets/cloudflare-protocol": {
      "import": "./src/widgets/CloudflareProtocol/Component.client.tsx",
      "types": "./src/widgets/CloudflareProtocol/Component.client.tsx",
      "default": "./src/widgets/CloudflareProtocol/Component.client.tsx"
    },
    "./widgets/cloudflare-status-codes": {
      "import": "./src/widgets/CloudflareStatusCodes/Component.client.tsx",
      "types": "./src/widgets/CloudflareStatusCodes/Component.client.tsx",
      "default": "./src/widgets/CloudflareStatusCodes/Component.client.tsx"
    },
    "./widgets/cloudflare-threats": {
      "import": "./src/widgets/CloudflareThreats/Component.client.tsx",
      "types": "./src/widgets/CloudflareThreats/Component.client.tsx",
      "default": "./src/widgets/CloudflareThreats/Component.client.tsx"
    },
    "./widgets/cloudflare-top-paths": {
      "import": "./src/widgets/CloudflareTopPaths/Component.client.tsx",
      "types": "./src/widgets/CloudflareTopPaths/Component.client.tsx",
      "default": "./src/widgets/CloudflareTopPaths/Component.client.tsx"
    },
    "./widgets/cloudflare-world-map": {
      "import": "./src/widgets/CloudflareWorldMap/Component.client.tsx",
      "types": "./src/widgets/CloudflareWorldMap/Component.client.tsx",
      "default": "./src/widgets/CloudflareWorldMap/Component.client.tsx"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "update-preview-image": "node scripts/update-preview-image.js",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.84.1",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/db-sqlite": "3.84.1",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@playwright/test": "1.58.2",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.2.6",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.2.6",
    "open": "^10.1.0",
    "payload": "3.84.1",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.34.2",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "payload": "^3.84.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
